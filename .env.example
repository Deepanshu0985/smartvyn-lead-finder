# --- Required -------------------------------------------------------------
# Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=

# Password for the /dashboard page
DASHBOARD_PASSWORD=

# Long random string. The scheduler sends it to /api/run so strangers cannot trigger runs.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- Telegram (where leads are sent) ----------------------------------------
# Create a bot with @BotFather, then send it a message and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage (required on Vercel) --------------------------------------------
# Run supabase/schema.sql first. Use the project's SECRET key (server-side only).
# Without these, leads live in memory: fine for local dev, lost between serverless runs.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Reddit (read-only) -------------------------------------------------------
# From https://www.reddit.com/prefs/apps (create a "script" app). Without these the app
# tries Reddit's public JSON, which Reddit often blocks from cloud servers.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: a descriptive User-Agent. Default identifies this tool.
# REDDIT_USER_AGENT=web:smartvyn-lead-finder:v0.1 (read-only lead finder by Smartvyn)

# --- Optional -----------------------------------------------------------------
# MISTRAL_CHAT_MODEL=mistral-small-latest

# --- Local testing only (see README) ---------------------------------------------
# MISTRAL_API_BASE=http://localhost:8787/v1
# TELEGRAM_API_BASE=http://localhost:8787
# REDDIT_FIXTURE_FILE=/tmp/reddit-fixture.json

    "@devvit/web": "0.15.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ajv": "^8.20.0",
    "devvit": "0.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}

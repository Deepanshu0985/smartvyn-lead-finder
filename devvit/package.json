{
  "name": "smartvyn-leads-devvit",
  "version": "0.1.0",
  "private": true,
  "description": "Smartvyn Lead Finder as a Reddit Devvit app: searches Reddit for fresh posts, ranks them with Mistral, sends the best to Telegram. Read-only.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
